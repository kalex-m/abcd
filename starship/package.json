{
  "name": "starship-launch-cinematic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Procedural real-time 3D cinematic of a super-heavy methalox launch, hot staging and tower catch.",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "physics-check": "tsx scripts/physics-check.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "shots": "node scripts/shots.mjs",
    "record": "node scripts/record.mjs",
    "lint": "eslint src scripts tests",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3",
    "stats-gl": "^4.2.3",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.181.0",
    "eslint": "^9.39.5",
    "ffmpeg-static": "^5.3.0",
    "prettier": "^3.10.1",
    "puppeteer": "^25.18.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-glsl": "^1.6.3"
  }
}
